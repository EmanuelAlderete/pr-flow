# App (default port avoids clashing with other local dev servers)
PORT=3847

# System logs: json (Docker/prod) ou pretty (dev local legível)
# LOG_FORMAT=pretty

# GitHub — token for gh CLI inside Docker.
# Easiest (same auth as `gh auth login` on the host):
#   ./scripts/sync-gh-env.sh
# Or manually: GH_TOKEN=$(gh auth token)
#
# Fine-grained PATs (github_pat_...) must include each repo AND authorize org SSO.
# See README "Como obter o GH_TOKEN".
GH_TOKEN=

# Repositories to monitor (owner/repo, comma-separated)
MONITORED_REPOSITORIES=owner/repo-1,owner/repo-2

# PostgreSQL
# Docker Compose (app service): use host "postgres"
DATABASE_URL=postgresql://prflow:prflow@postgres:5432/prflow

# Local npm dev (postgres only via compose): use host "localhost"
# DATABASE_URL=postgresql://prflow:prflow@localhost:5432/prflow

# Gemini — resumo diário no Dashboard (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Nível de carreira para orientação nos resumos (junior | pleno | senior). Padrão: junior
# SUMMARY_CAREER_LEVEL=junior

# Jira Cloud — tickets atribuídos ao usuário (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=
JIRA_TOKEN=
# JIRA_SITE_URL=https://jusfy.atlassian.net
# JIRA_SPRINT_PROJECT_KEY=JOR
# JIRA_SPRINT_BOARD_ID=1032
# DISABLE_JIRA_SYNC_CRON=1

# Slack — compartilhar PR no canal squad-jornada-pr (escopo chat:write)
SLACK_BOT_OAUTH_TOKEN=
# SLACK_PR_CHANNEL=squad-jornada-pr
