# App (default port avoids clashing with other local dev servers)
PORT=3847

# System logs: json (Docker/prod) ou pretty (dev local legível)
# LOG_FORMAT=pretty

# GitHub — token for gh CLI inside Docker.
# Easiest (same auth as `gh auth login` on the host):
#   ./scripts/sync-gh-env.sh
# Or manually: GH_TOKEN=$(gh auth token)
#
# Fine-grained PATs (github_pat_...) must include each repo AND authorize org SSO.
# See README "Como obter o GH_TOKEN".
GH_TOKEN=

# Repositories to monitor (owner/repo, comma-separated)
MONITORED_REPOSITORIES=owner/repo-1,owner/repo-2

# SQLite local. Caminho relativo à raiz do projeto.
DATABASE_URL=file:./data/pr-flow.sqlite

# Revisão local de PRs via Claude Code (assinatura, não API).
# Gere com `claude setup-token` se o processo não herdar o login do usuário.
# Não defina ANTHROPIC_API_KEY: o modo não interativo passaria a cobrar a API.
# CLAUDE_CODE_OAUTH_TOKEN=
# PR_REVIEW_MODEL=haiku
# DISABLE_PR_LOCAL_REVIEW_CRON=1

# Gemini — resumos, briefing e corpo de PR (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Modelos alternativos se o principal estiver indisponível (503), separados por vírgula
# GEMINI_MODEL_FALLBACK=gemini-2.0-flash,gemini-1.5-flash

# Nível de carreira para orientação nos resumos (junior | pleno | senior). Padrão: junior
# SUMMARY_CAREER_LEVEL=junior
# SUMMARY_CRON_TZ=America/Sao_Paulo

# Jira Cloud — tickets atribuídos ao usuário
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_TOKEN=
# JIRA_SITE_URL=https://jusfy.atlassian.net
# JIRA_SPRINT_PROJECT_KEY=JOR
# JIRA_SPRINT_BOARD_ID=1032
# DISABLE_JIRA_SYNC_CRON=1
# DISABLE_PR_SYNC_CRON=1
# DISABLE_SUMMARY_CRON=1
# DISABLE_DASHBOARD_BRIEFING_CRON=1

# Slack — compartilhar PR no canal (https://api.slack.com/apps — escopo chat:write)
SLACK_BOT_OAUTH_TOKEN=
# SLACK_PR_CHANNEL=squad-jornada-pr

# Google Calendar — feed iCal secreto
# Agenda → Configurações → Integrar agenda → Endereço secreto
# Ajuda: https://support.google.com/calendar/answer/37648
# Nunca commitar a URL completa. Ex.: https://calendar.google.com/calendar/ical/.../private-.../basic.ics
GOOGLE_CALENDAR_ICAL_URL=

# Stack Docker local Jusfy (Devtools → Ambiente local / Portainer)
# Pasta que contém docker-compose.dev.yml (stack pessoal, fora deste repo)
# LOCAL_DOCKER_ROOT=/caminho/para/local-docker
# Raiz dos clones jusfy no host (interpola volumes no compose)
# JUSFY_ROOT=/home/usuario/jusfy
# URL do Portainer no browser (padrão https://localhost:9443)
# LOCAL_DOCKER_PORTAINER_URL=https://localhost:9443
